# ==============================================================================
# CONFIGURATION DES SECRETS GOOGLE AI STUDIO & STRIPE
# ==============================================================================
# Ces variables sont à renseigner dans la console Google AI Studio :
# Menu de gauche > Panneau "Secrets" (icône de cadenas) ou "Environment Variables".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
# Clé API Google Gemini requise pour les diagnostics de peau IA et le scanner INCI.
# AI Studio injecte automatiquement cette variable à l'exécution.
GEMINI_API_KEY="AIzaSy..."

# URL racine de l'application (injectée automatiquement par AI Studio / Cloud Run)
APP_URL="https://votre-app.run.app"

# ------------------------------------------------------------------------------
# 2. STRIPE - PAIEMENT & ABONNEMENTS MENSUELS CABINE
# ------------------------------------------------------------------------------
# Clé secrète Stripe (obtenue sur https://dashboard.stripe.com/apikeys)
# Utilisez sk_test_... en phase de test ou sk_live_... en production.
STRIPE_SECRET_KEY="sk_test_51P..."

# Clé publique Stripe (utilisée côté client pour les éléments de paiement)
STRIPE_PUBLISHABLE_KEY="pk_test_51P..."

# Clé secrète de signature des Webhooks Stripe (obtenue sur https://dashboard.stripe.com/webhooks)
# Permet de valider l'authenticité des notifications de paiement Stripe.
# URL du Webhook à enregistrer sur Stripe : https://<votre-app>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# (Optionnel) Identifiants de tarifs récurrents Stripe prédéfinis dans votre catalogue
# Si non définis, l'application crée automatiquement les tarifs récurrents à la volée.
STRIPE_PRICE_PRO_MONTHLY="price_1..."        # Forfait Pro Esthéticienne : 29.00 EUR / mois
STRIPE_PRICE_PRO_YEARLY="price_1..."         # Forfait Pro Annuel : 288.00 EUR / an (24€/m)
STRIPE_PRICE_PRESTIGE_MONTHLY="price_1..."   # Forfait Institut Prestige : 69.00 EUR / mois
STRIPE_PRICE_PRESTIGE_YEARLY="price_1..."    # Forfait Institut Prestige Annuel : 708.00 EUR / an (59€/m)

# ------------------------------------------------------------------------------
# 3. GOOGLE PLAY CONSOLE - DIGITAL ASSET LINKS & APP LINKS
# ------------------------------------------------------------------------------
# Empreinte du certificat SHA-256 de signature d'application (App Signing Certificate)
# Obtenue dans Google Play Console : Configuration > Intégrité de l'application
# Permet de valider instantanément la propriété de domaine sans avertissement Google Play.
# Format : XX:XX:XX:XX:... (plusieurs empreintes possibles séparées par une virgule)
ANDROID_SHA256_FINGERPRINT="14:6D:E9:EB:18:66:47:FD:A2:29:43:8B:1A:1C:CE:F6:C3:0A:94:41:F0:8A:E2:E2:B0:1B:67:86:14:8B:2A:4E"
